    "icons": "node scripts/make-icons.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "xlsx-js-style": "1.2.0"
  }
}
